<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:simpleType name="SiegeType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-F][0-9]{2}"></xs:pattern>
        </xs:restriction>
    </xs:simpleType>
    <xs:element name="billet">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="siege" type="SiegeType" />
                <xs:element name="prix" type="xs:positiveInteger" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>